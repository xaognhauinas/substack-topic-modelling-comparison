# Data: never commit the raw dataset or regenerable intermediates
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep

# Model files and caches
*.npy
*.pt
*.bin
*.pkl
.cache/
models.yaml.bak
models_tuned.yaml.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.whl
dist/
build/
*.egg
.eggs/

# Type checking
.mypy_cache/
.pytype/
.pyre/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Testing
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment variables and secrets
.env
.env.local
.env*.local
*.pem
*.key

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
